{
  "name": "comicvine-api-local",
  "version": "1.0.0",
  "private": true,
  "description": "A local mock ComicVine API backed by the supplied SQLite database.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "sync": "node --env-file-if-exists=.env src/updater.js",
    "sync:full": "node --env-file-if-exists=.env src/updater.js --full"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}