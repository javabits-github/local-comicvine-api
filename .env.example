PORT=3333
HOST=127.0.0.1
COMICVINE_DB_PATH=./localcv.db

# Optional paging overrides. When unset the defaults are: list 100, search 10, max 100.
# COMICVINE_MAX_LIMIT=100
# COMICVINE_DEFAULT_LIMIT=100
# COMICVINE_SEARCH_DEFAULT_LIMIT=10
# Forces a fixed page size on the search endpoint only, overriding the client's ?limit= (still clamped to the max).
# COMICVINE_FORCED_LIMIT=

# SRV-8 live-API validation on detail endpoints. When set, each detail request
# also diffs the entity against the live ComicVine API and reports a `validation`
# field. Requires COMICVINE_API_KEY (same key the updater uses); without it the
# validator is skipped. Consumes live API quota — enable only when checking data.
# COMICVINE_VALIDATE=
# COMICVINE_API_KEY=

# SRV-10 minimum log level: debug, info (default), warn, or error. Entries below
# the threshold are dropped; warn/error also write to stderr.
# COMICVINE_LOG_LEVEL=info

# SRV-7 optional file logging. When a path is set, every emitted log entry is
# also appended to that file (stdout/stderr logging continues regardless). The
# file is rotated when it exceeds COMICVINE_LOG_MAX_SIZE (default 10 MiB): the
# current file becomes <path>.1, .1 becomes .2, up to COMICVINE_LOG_MAX_FILES
# generations (default 5), the oldest removed.
# COMICVINE_LOG_FILE=
# COMICVINE_LOG_MAX_SIZE=10485760
# COMICVINE_LOG_MAX_FILES=5

# SRV-12 publisher blocklist: comma-separated publisher ids whose volumes are
# excluded from volume search and list results. An explicit ?filter=publisher_id=
# (or publisher:) request overrides the blocklist for that request.
# COMICVINE_PUBLISHER_BLOCKLIST=

# SRV-13 optional API-key authentication. Comma-separated list of accepted keys.
# When unset (empty) the server serves every endpoint unauthenticated — the
# default for local use. When one or more keys are set, requests to the resource
# endpoints (search/list/detail) must present a matching key via the api_key query
# parameter, the X-Api-Key header, or an Authorization: Bearer header; a missing
# or invalid key returns HTTP 401 with status_code 100. The local-only /api index
# and /api/status endpoints stay open without a key.
# COMICVINE_API_KEYS=

# SRV-14 CORS. Comma-separated list of allowed origins (e.g. http://localhost:5173,
# https://myapp.example). When unset (empty) the server is permissive and sends
# Access-Control-Allow-Origin: * on every response — the default for local dev.
# When one or more origins are set, the request's Origin is echoed only on a match
# (plus Vary: Origin); a non-matching Origin gets no CORS grant.
# COMICVINE_CORS_ORIGINS=

# SRV-1 default sort column for list endpoints that have no ?sort=. A single
# sortable field name (e.g. name) applied to every resource. When unset, every
# list endpoint defaults to id ASC (the live API's ordering). A per-resource
# default is set via the defaultSort option on createApiServer, not an env var.
# COMICVINE_DEFAULT_SORT=
