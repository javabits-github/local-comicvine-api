# Dependencies
node_modules/
npm-debug.log*

# Environment and credentials (hold COMICVINE_API_KEY, SMTP_PASS) — the
# .env.example / comicvine_config.env.example templates are committed instead.
.env
sqlite_cv_updater/comicvine_config.env

# Python bytecode
__pycache__/

# Databases. All SQLite files are large (multi-GB) and are rebuilt by the
# updater, so none are committed. This covers the live DB, dated snapshots,
# their -wal/-shm sidecars, backups, and the raw source dumps.
*.db
*.db-wal
*.db-shm
*.db.bak
*.db.pre-backfill.bak